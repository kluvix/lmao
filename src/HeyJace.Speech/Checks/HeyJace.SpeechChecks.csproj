<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <StartupObject>SpeechChecks.Entry</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../HeyJace.Core/HeyJace.Core.csproj" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <Compile Include="../Program.cs" Link="SpeechHost.cs" />
    <Compile Include="../PipeConnection.cs" Link="PipeConnection.cs" />
    <Compile Include="../RecognitionVocabulary.cs" Link="RecognitionVocabulary.cs" />
    <Compile Include="../RecognitionGrammars.cs" Link="RecognitionGrammars.cs" />
    <Compile Include="../RecognitionCandidates.cs" Link="RecognitionCandidates.cs" />
  </ItemGroup>
</Project>
